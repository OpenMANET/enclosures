# Lab fleet credentials. Copy to .credentials and fill in.
# SSH is key-based (SSH_KEY); SUDO_PASS is for remote sudo.
SSH_USER="radio"
SUDO_PASS="CHANGE_ME"
SSH_KEY="$HOME/.ssh/mesh-fleet"
# Fleet mesh identity (reference; the old/ setup-node.sh --join used it).
MESH_SSID="rdt-manet"
MESH_KEY="CHANGE_ME"
