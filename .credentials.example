# Lab fleet credentials. Copy to .credentials and fill in.
# SSH is key-based (SSH_KEY); SUDO_PASS is for remote sudo.
SSH_USER="radio"
SUDO_PASS="CHANGE_ME"
SSH_KEY="$HOME/.ssh/mesh-fleet"
# Fleet mesh identity — used by setup-node.sh --join to make a new node join THIS mesh.
MESH_SSID="A-PN-MN"
MESH_KEY="CHANGE_ME"
