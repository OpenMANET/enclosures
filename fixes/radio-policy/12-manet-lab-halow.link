# NOT IN USE. Tried on mesh-c370 2026-10-13 and removed: it cannot fix the
# replacement-board boot, because the Morse driver loads first and every wlan
# name is taken by the time this would apply. Kept as a record; see FIXES.md.
#
# Intent: name any Morse HaLow USB radio wlan2 when no MAC pin matches.

[Match]
Driver=morse_usb
Type=wlan

[Link]
Name=wlan2
